MONGODB_URI=mongodb://localhost:27017/oms
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:5173
# Optional hostname allowlist; ports do not need to be included.
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# cluster.py sets these automatically. TRUST_PROXY=1 requires a private token.
TRUST_PROXY=0
OMS_PROXY_TOKEN=
OMS_PROXY_PEERS=127.0.0.1/32,::1/128
# Optional shared absolute upload directory; blank uses app/static/uploads.
OMS_UPLOAD_FOLDER=
# Optional bootstrap password: creates admin only if it does not exist.
ADMIN_PASSWORD=
# Password recovery requires SMTP with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Public products/content cache. Set to 0 to disable without changing code.
PUBLIC_CACHE_ENABLED=1
